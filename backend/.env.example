NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=neighbourhood_signal_demo
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
JWT_SECRET=local-demo-access-secret-change-before-deployment
JWT_REFRESH_SECRET=local-demo-refresh-secret-change-before-deployment
JWT_ACCESS_EXPIRY=2h
DEMO_MODE=true
CORS_ORIGIN=http://127.0.0.1:5173

# Relative to backend/ when using npm run dev
DEMO_OTP_FILE=.local/demo-otps.json
WEB_PUSH_SUBJECT=mailto:demo@example.com

# NIPOST Postcode API (https://docs.postcode.gov.ng)
# Create a key at https://dashboard.postcode.gov.ng (Settings -> API Keys)
# Test keys (nipost_test_...) resolve a sandbox dataset; live keys need KYB.
# Leave empty to run with offline postcode format validation only.
NIPOST_API_KEY=
NIPOST_BASE_URL=https://api.postcode.gov.ng
# Lookup level for report enrichment: 1 = validity only (free), 2+ = address details (credits)
NIPOST_LOOKUP_LEVEL=1

# Local evidence storage (relative to backend/ when using npm run dev)
EVIDENCE_STORAGE_DIR=.local/evidence
EVIDENCE_MAX_BYTES=5242880

# WhatsApp Cloud API OTP delivery (console driver is local demo only)
WHATSAPP_DRIVER=console
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=otp_verification
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_OTP_SECRET=demo-otp-secret-change-me
WHATSAPP_OTP_TTL_SECONDS=300
WHATSAPP_OTP_MAX_ATTEMPTS=3
WHATSAPP_OTP_RATE_LIMIT=3
WHATSAPP_OTP_RATE_WINDOW_SECONDS=900

# Request rate limiting (Redis-backed)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=false
BIND_HOST=127.0.0.1
JSON_BODY_LIMIT=8mb
SWAGGER_ENABLED=false

# SMS OTP fallback (OTP_DELIVERY_DRIVER=sms)
OTP_DELIVERY_DRIVER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Subscription payments (PAYMENT_PROVIDER=paystack)
PAYMENT_PROVIDER=demo
PAYMENT_BASE_URL=https://api.paystack.co
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=NGN
PAYMENT_CALLBACK_URL=

# External SOS dispatch (DISPATCH_DRIVER=sms)
DISPATCH_DRIVER=off
DISPATCH_API_URL=
DISPATCH_API_KEY=
DISPATCH_SENDER_ID=

# SOS escalation worker
SOS_ESCALATION_ENABLED=false
SOS_ESCALATION_POLL_MS=60000
SOS_ESCALATION_MAX_LEVELS=2

# Evidence object storage and scanning
EVIDENCE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
EVIDENCE_SCANNER_DRIVER=passthrough
EVIDENCE_SCANNER_HOST=127.0.0.1
EVIDENCE_SCANNER_PORT=3310
EVIDENCE_SCANNER_TIMEOUT_MS=10000
EVIDENCE_RETENTION_DAYS=90
EVIDENCE_RETENTION_ENABLED=true
EVIDENCE_RETENTION_INTERVAL_MS=86400000
