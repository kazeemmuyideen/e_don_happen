NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=55432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=neighbourhood_signal_demo
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
JWT_SECRET=local-demo-access-secret-change-before-deployment
JWT_REFRESH_SECRET=local-demo-refresh-secret-change-before-deployment
JWT_ACCESS_EXPIRY=2h
DEMO_MODE=true
CORS_ORIGIN=http://127.0.0.1:5173

# Relative to backend/ when using npm run dev
DEMO_OTP_FILE=.local/demo-otps.json
WEB_PUSH_SUBJECT=mailto:demo@example.com

# NIPOST Postcode API (https://docs.postcode.gov.ng)
# Create a key at https://dashboard.postcode.gov.ng (Settings -> API Keys)
# Test keys (nipost_test_...) resolve a sandbox dataset; live keys need KYB.
# Leave empty to run with offline postcode format validation only.
NIPOST_API_KEY=
NIPOST_BASE_URL=https://api.postcode.gov.ng
# Lookup level for report enrichment: 1 = validity only (free), 2+ = address details (credits)
NIPOST_LOOKUP_LEVEL=1

# Local evidence storage (relative to backend/ when using npm run dev)
EVIDENCE_STORAGE_DIR=.local/evidence
EVIDENCE_MAX_BYTES=5242880
